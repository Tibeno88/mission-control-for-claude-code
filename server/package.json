{
  "name": "@cmc/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "backup": "node dist/backup/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "better-sqlite3": "13.0.3",
    "chokidar": "5.0.0",
    "hono": "4.12.30",
    "node-cron": "4.6.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.1.1",
    "@types/node-cron": "3.0.11",
    "@types/ws": "8.18.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
